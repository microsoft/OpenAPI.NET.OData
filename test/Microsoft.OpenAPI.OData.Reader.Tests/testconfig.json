{
  "platformOptions": {
    "Coverlet": {
      "include": "[Microsoft.OpenApi.OData.Reader]*",
      "exclude": "[*.Tests]*",
      "excludeByAttribute": "GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverage,ExcludeFromCodeCoverageAttribute",
      "format": "opencover",
      "includeTestAssembly": false,
      "excludeAssembliesWithoutSources": "MissingAll"
    }
  }
}
